# Copy to .env and fill in ONLY the channels you use.
# .env is ignored by Git. Never commit real values.

# Dashboard / API token (required if the API is exposed beyond 127.0.0.1)
NETTRACKER_API_TOKEN=

# Discord notifications
NETTRACKER_DISCORD_WEBHOOK_URL=

# Telegram notifications
NETTRACKER_TELEGRAM_BOT_TOKEN=
NETTRACKER_TELEGRAM_CHAT_ID=

# E-mail notifications (optional)
NETTRACKER_SMTP_HOST=
NETTRACKER_SMTP_PORT=
NETTRACKER_SMTP_USER=
NETTRACKER_SMTP_PASSWORD=
NETTRACKER_SMTP_FROM=
NETTRACKER_SMTP_TO=
